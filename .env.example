# === MagicTech Quotation Designer — Environment ===

# ---------------------------------------------------------------------------
# Postgres (required)
# ---------------------------------------------------------------------------
# The app talks to Postgres through the `postgres` driver, so any provider
# works (Neon, RDS, self-hosted, …). For serverless use a POOLED connection
# string (e.g. a transaction pooler on port 6543); the driver runs with
# `prepare: false`, which poolers require.
#
# Resolution order (first non-empty wins):
#   DATABASE_URL → POSTGRES_URL → POSTGRES_PRISMA_URL → POSTGRES_URL_NON_POOLING
#
# Format:
#   postgres://<user>:<password>@<host>:<port>/<database>
#
# IMPORTANT: Do NOT commit this value. Set it in your host's environment
# variables (e.g. Vercel → Project Settings → Environment Variables), marked
# "Sensitive" for all environments.
DATABASE_URL=
# Alternatives the driver also accepts (first non-empty wins):
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# ---------------------------------------------------------------------------
# Cloudflare R2 — file storage (REQUIRED for uploads)
# ---------------------------------------------------------------------------
# Project files (BOQs, POs, PDFs, photos) are uploaded by the browser
# straight into R2 via a presigned URL, viewed/downloaded via a presigned
# GET, and deleted from R2. Without these vars, file uploads fail
# (sign-upload returns 503).
#
# Create an R2 API token: Cloudflare dashboard → R2 → Manage API tokens →
# Create (Object Read & Write). The bucket must already exist
# (`wrangler r2 bucket create magictech-files`).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Optional — defaults to "magictech-files".
CLOUDFLARE_R2_BUCKET=magictech-files
#
# IMPORTANT — CORS: the browser PUTs/GETs directly to
# <account>.r2.cloudflarestorage.com, which is cross-origin, so the bucket
# needs a CORS policy (R2 → bucket → Settings → CORS Policy) allowing your
# app origin(s). Example:
#   [
#     {
#       "AllowedOrigins": ["https://your-app.example.com", "http://localhost:3000"],
#       "AllowedMethods": ["GET", "PUT", "HEAD"],
#       "AllowedHeaders": ["*"],
#       "ExposeHeaders": ["ETag"],
#       "MaxAgeSeconds": 3600
#     }
#   ]

# ---------------------------------------------------------------------------
# App auth
# ---------------------------------------------------------------------------
# JWT signing secret. MUST be a long (>=32 chars) random string.
# Generate with:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# Default admin credentials used on first boot. CHANGE IMMEDIATELY after
# first login from the /admin page.
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin123

# ---------------------------------------------------------------------------
# Web Push notifications (PWA) — V1.3b
# ---------------------------------------------------------------------------
# Lets the installed app deliver OS-level notifications (handoffs,
# approvals, change requests, assignments) even when it's closed. Generate
# a keypair once with:
#   npm run vapid:gen
# then paste the values here / into Vercel env. The PUBLIC key is sent to
# the browser to create the subscription; the PRIVATE key is a secret used
# only on the server to sign pushes — never expose it to the client.
# If these are left blank, push simply stays off and the "enable
# notifications" control hides itself; the rest of the app is unaffected.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact handle required by the Web Push spec (mailto: or https URL).
VAPID_SUBJECT=mailto:notifications@magictech.local

# ---------------------------------------------------------------------------
# Groq (required for the AI designer)
# ---------------------------------------------------------------------------
# Free tier key: https://console.groq.com/keys
GROQ_API_KEY=

# Groq models
# Design model — pick any chat model from the GROQ_CHAT_MODELS catalog:
#   llama-3.3-70b-versatile (default)  |  llama-3.1-8b-instant
#   meta-llama/llama-4-scout-17b-16e-instruct
#   moonshotai/kimi-k2-instruct         |  moonshotai/kimi-k2-instruct-0905
#   openai/gpt-oss-120b                 |  openai/gpt-oss-20b
#   qwen/qwen3-32b
GROQ_DESIGN_MODEL=llama-3.3-70b-versatile
# Agentic model with built-in web search for deep-dive fallbacks
#   groq/compound (default)  |  groq/compound-mini
GROQ_WEB_MODEL=groq/compound

# ---------------------------------------------------------------------------
# GitHub catalog
# ---------------------------------------------------------------------------
# GitHub repo (owner/name) that hosts the DATABASE/ folder.
# The app fetches JSON files from raw.githubusercontent.com of this repo.
GITHUB_REPO=eeya7ya/Data-Analayser
GITHUB_BRANCH=claude/migrate-neon-to-supabase-a3m4d

# Logo on GitHub (raw URL). Falls back to /logo-placeholder.svg if empty.
COMPANY_LOGO_URL=

# ---------------------------------------------------------------------------
# Email integration (IMAP/SMTP) — required only if you use the Email feature
# ---------------------------------------------------------------------------
# 32-byte key used to encrypt stored mailbox passwords (AES-256-GCM). Mailbox
# passwords cannot be hashed (we need the plaintext to log into the customer's
# IMAP/SMTP server), so they are encrypted with this key and decrypted only
# in-memory, server-side, when a connection is opened. The key lives ONLY in
# the environment — never in the database or the code.
#
# Generate one with:   openssl rand -base64 32
# (hex of 64 chars also accepted). Keep it secret and stable: rotating it makes
# previously-saved mailbox passwords undecryptable (they'd need re-entering).
EMAIL_ENCRYPTION_KEY=
